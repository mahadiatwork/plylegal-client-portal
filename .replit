modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["bfg-repo-cleaner"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33677
externalPort = 8081

[[ports]]
localPort = 35335
externalPort = 5173

[[ports]]
localPort = 35989
externalPort = 3002

[[ports]]
localPort = 36139
externalPort = 5000

[[ports]]
localPort = 36899
externalPort = 8099

[[ports]]
localPort = 37677
externalPort = 3001

[[ports]]
localPort = 41865
externalPort = 8080

[[ports]]
localPort = 42375
externalPort = 3000

[[ports]]
localPort = 42407
externalPort = 4200

[[ports]]
localPort = 43019
externalPort = 9000

[[ports]]
localPort = 43191
externalPort = 6000

[[ports]]
localPort = 43391
externalPort = 8000

[[ports]]
localPort = 44271
externalPort = 8008

[[ports]]
localPort = 44409
externalPort = 3003

[[ports]]
localPort = 45021
externalPort = 6800

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000
