# Ply Legal - Environment Configuration Example
# Copy this to .env.local and fill in your values

# ===================================
# Database Configuration
# ===================================

# Database Type: localStorage | firebase | postgres
# - localStorage: Browser storage (backup option, works perfectly)
# - firebase: Firebase Firestore (CURRENT - real-time sync, cloud storage)
# - postgres: PostgreSQL with Drizzle (alternative, not yet implemented)
NEXT_PUBLIC_DATABASE_TYPE=firebase
PREVIEW_TOKEN_SECRET=replace-with-a-long-random-server-secret

# ===================================
# Firebase Configuration (CONFIGURED IN REPLIT SECRETS)
# ===================================
# These are already set up in Replit Secrets for security
# DO NOT add them to this file - use Replit's Secrets manager

# Required Firebase secrets (configured):
# - NEXT_PUBLIC_FIREBASE_API_KEY
# - NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
# - NEXT_PUBLIC_FIREBASE_PROJECT_ID  
# - NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
# - NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
# - NEXT_PUBLIC_FIREBASE_APP_ID

# ===================================
# PostgreSQL Configuration (if using postgres)
# ===================================
# Uncomment when ready to use Postgres

# DATABASE_URL=postgresql://user:password@host:port/database

# ===================================
# Session Configuration
# ===================================
# SESSION_SECRET is already configured in Replit Secrets

# ===================================
# Application Configuration
# ===================================
# NODE_ENV=development
# REPLIT_DOMAINS is automatically set by Replit

# ===================================
# Notes
# ===================================
# 
# Current Status:
# - localStorage adapter: ✅ Fully working (default)
# - Firebase adapter: ⏳ Stub only (needs implementation)
# - Postgres adapter: ⏳ Stub only (needs implementation)
#
# Recommendation:
# Keep using localStorage (default) until Firebase is fully implemented.
# The adapter system is ready when you need it!
